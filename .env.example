# 複製成 .env 後填值。.env 已在 .gitignore 中，永遠不要 commit。

# LINE Messaging API（LINE Developers Console → 小鳥啾啾）
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_OWNER_USER_ID=
LINE_FAMILY_GROUP_ID=

# Hermes Agent 存取控制與推播目的地（值通常就是上面的 User ID / Group ID）
LINE_ALLOWED_USERS=
LINE_ALLOWED_GROUPS=
LINE_HOME_CHANNEL=

# 模型供應商（依 agent 實際使用填寫）
ANTHROPIC_API_KEY=
